{
  "expo": {
    "name": "RecoverCare",
    "slug": "recovercare",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "recovercare",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0B1F3F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.recovercare.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1F3F"
      },
      "package": "com.recovercare.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
