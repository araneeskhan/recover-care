generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  NURSE
  DOCTOR
}

enum StaffRole {
  SURGEON
  NURSE
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient   Patient?
  staff     Staff?
}

model Patient {
  id           String   @id @default(uuid())
  userId       String   @unique
  firstName    String
  lastName     String
  mrn          String   @unique
  age          Int
  phone        String?
  surgeryType  String
  surgeryDate  DateTime
  hospital     String
  recoveryDays Int      @default(14)
  emergencyContactName  String?
  emergencyContactPhone String?
  bloodType    String?
  allergies    String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id])
  checkIns     CheckIn[]
  medications  Medication[]
  appointments Appointment[]
  sentMessages     Message[]        @relation("PatientMessages")
  alerts       Alert[]
  careTeam     CareTeamAssignment[]
  woundPhotos  WoundPhoto[]
}

model Staff {
  id            String    @id @default(uuid())
  userId        String    @unique
  firstName     String
  lastName      String
  staffRole     StaffRole
  specialty     String
  department    String?
  licenseNumber String?
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user             User                 @relation(fields: [userId], references: [id])
  assignments      CareTeamAssignment[]
  messages         Message[]            @relation("StaffMessages")
  resolvedAlerts   Alert[]              @relation("AlertResolutions")
}

model CheckIn {
  id          String   @id @default(uuid())
  patientId   String
  painLevel   Int
  temperature Float?
  symptoms    String[]
  notes       String?
  mood        String?
  step        Int      @default(4)
  staffNotes  String?
  createdAt   DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
  alerts  Alert[]
}

model Medication {
  id           String   @id @default(uuid())
  patientId    String
  name         String
  dosage       String
  frequency    String
  instructions String?
  totalDoses   Int
  takenDoses   Int      @default(0)
  isActive     Boolean  @default(true)
  nextDoseAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient Patient         @relation(fields: [patientId], references: [id])
  logs    MedicationLog[]
}

model MedicationLog {
  id           String   @id @default(uuid())
  medicationId String
  takenAt      DateTime @default(now())

  medication Medication @relation(fields: [medicationId], references: [id])
}

model Message {
  id        String   @id @default(uuid())
  patientId String
  staffId   String
  content   String
  senderId  String
  senderType Role
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  patient Patient @relation("PatientMessages", fields: [patientId], references: [id])
  staff   Staff   @relation("StaffMessages", fields: [staffId], references: [id])
}

model Appointment {
  id          String   @id @default(uuid())
  patientId   String
  title       String
  description String?
  dateTime    DateTime
  duration    Int
  createdAt   DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}

model Alert {
  id           String        @id @default(uuid())
  patientId    String
  checkInId    String?
  severity     AlertSeverity
  message      String
  isResolved   Boolean       @default(false)
  resolvedById String?
  resolvedAt   DateTime?
  resolutionNote String?
  createdAt    DateTime      @default(now())

  patient    Patient  @relation(fields: [patientId], references: [id])
  checkIn    CheckIn? @relation(fields: [checkInId], references: [id])
  resolvedBy Staff?   @relation("AlertResolutions", fields: [resolvedById], references: [id])
}

model CareTeamAssignment {
  id        String @id @default(uuid())
  patientId String
  staffId   String

  patient Patient @relation(fields: [patientId], references: [id])
  staff   Staff   @relation(fields: [staffId], references: [id])

  @@unique([patientId, staffId])
}

model WoundPhoto {
  id        String   @id @default(uuid())
  patientId String
  photoUri  String
  caption   String?
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}
